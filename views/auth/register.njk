{% extends "base.njk" %}

{% block content %}
<div class="card" style="max-width: 450px; margin: 3rem auto;">
    <h2 style="margin-bottom: 1.5rem; text-align: center;">Crear Cuenta</h2>

    {% if errors and errors.length > 0 %}
        <div class="alert alert-danger">
            <ul style="margin-left: 1rem;">
                {% for err in errors %}
                    <li>{{ err.msg }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form action="/register" method="POST">
        <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" class="form-control" value="{{ form.email | default('') }}" required placeholder="usuario@ejemplo.com">
        </div>

        <div class="form-group">
            <label for="password">Contraseña (Mínimo 6 caracteres)</label>
            <input type="password" id="password" name="password" class="form-control" required placeholder="••••••••">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 1rem;">Registrarse</button>
    </form>

    <p style="text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: 0.9rem;">
        ¿Ya tienes cuenta? <a href="/login" style="color: var(--secondary-color);">Inicia sesión</a>
    </p>
</div>
{% endblock %}
